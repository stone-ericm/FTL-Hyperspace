struct ShipSystem
{{
	ShipSystem() { }

	ShipSystem(int systemId, int roomId, int shipId, int startingPower)
	{
		this->constructor(systemId, roomId, shipId, startingPower);
	}

	void CompleteSave(int fd);
	void CompleteLoad(int fd);
}};
