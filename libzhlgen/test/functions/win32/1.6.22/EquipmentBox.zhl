struct EquipmentBox depends (AugmentBlueprint)
{{
	EquipmentBox()
	{
	}

	EquipmentBox(Point pos, int slot)
	{
		this->constructor(pos, slot);
	}

	bool IsEmpty()
	{
		return !item.pWeapon && !item.pDrone && (!item.augment || item.augment->name.empty()) && !item.pCrew;
	}
}};
